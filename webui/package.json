{
  "name": "pixel-art-react",
  "version": "3.10.0",
  "description": "Draw and animate Pixel Art, then export the results to CSS or download them, powered by React",
  "author": "Javier Valencia Romero",
  "scripts": {
    "lint": "eslint **/*.{js,jsx}",
    "csslint": "stylelint src/**/*.{css,js,jsx}",
    "prettier": "prettier **/*.{js,jsx,json,yml,yaml,css,md}",
    "format": "npm run prettier -- --write --list-different",
    "test": "jest",
    "test:watch": "npm run test -- --watch",
    "validate": "npm run lint && npm run csslint && npm run prettier -- --list-different && npm run test",
    "development": "webpack-dev-server --hot",
    "deploy": "set NODE_ENV=production webpack --mode production --config webpack.production.config.js",
    "postinstall": "set NODE_ENV=production webpack --mode production --config webpack.production.config.js",
    "build": "webpack build --mode production --config webpack.production.config.js"
  },
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/jvalen/pixel-art-react"
  },
  "keywords": [
    "pixel",
    "art",
    "drawing",
    "react",
    "redux",
    "express"
  ],
  "license": "MIT",
  "jest": {
    "setupFiles": [
      "jest-canvas-mock"
    ]
  },
  "dependencies": {
    "assert": "^2.1.0",
    "autoprefixer": "^9.8.8",
    "axios": "^1.7.9",
    "blob-stream": "^0.1.3",
    "body-scroll-lock-upgrade": "^1.1.0",
    "box-shadow-pixels": "0.0.4",
    "buffer": "^6.0.3",
    "canvas-toBlob": "^1.0.0",
    "css-loader": "^3.2.0",
    "dotenv-webpack": "^8.1.0",
    "file-loader": "^6.2.0",
    "file-saver": "^2.0.5",
    "gif-encoder": "^0.7.2",
    "gm": "^1.25.0",
    "immutable": "^5.0.3",
    "lost": "^9.0.2",
    "oauth": "^0.10.0",
    "pako": "^2.1.0",
    "postcss-import": "^16.1.0",
    "postcss-loader": "^8.1.1",
    "postcss-reporter": "^7.1.0",
    "precss": "^2.0.0",
    "prop-types": "^15.8.1",
    "pug": "^3.0.3",
    "react": "^16.8.6",
    "react-addons-pure-render-mixin": "^15.6.3",
    "react-addons-shallow-compare": "^15.6.3",
    "react-beautiful-dnd": "^12.1.1",
    "react-color": "^2.19.3",
    "react-cookie-consent": "^5.2.0",
    "react-custom-scrollbars": "^4.2.1",
    "react-dom": "^16.8.6",
    "react-ga": "^3.3.1",
    "react-is": "^19.0.0",
    "react-modal": "^3.16.3",
    "react-redux": "^7.1.0",
    "react-router-dom": "^6.16.0",
    "react-transform-hmr": "^1.0.4",
    "react-transition-group": "^2.3.1",
    "redux": "^5.0.1",
    "redux-undo": "^1.1.0",
    "shortid": "^2.2.17",
    "stream-browserify": "^3.0.0",
    "style-loader": "^4.0.0",
    "styled-components": "^6.1.14",
    "styled-theming": "^2.2.0",
    "temp": "^0.9.4",
    "tinykeys": "^1.4.0",
    "twitter": "^1.7.1",
    "url-loader": "^4.1.1",
    "util": "^0.12.5",
    "whatwg-fetch": "^3.6.20"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "devDependencies": {
    "@babel/core": "^7.26.7",
    "@babel/preset-env": "^7.26.7",
    "@babel/preset-react": "^7.26.3",
    "@babel/runtime-corejs2": "^7.26.7",
    "babel-core": "^7.0.0-bridge.0",
    "babel-eslint": "^10.1.0",
    "babel-jest": "^29.7.0",
    "babel-loader": "^9.2.1",
    "babel-plugin-react-transform": "^3.0.0",
    "clean-webpack-plugin": "^4.0.0",
    "compression-webpack-plugin": "^11.1.0",
    "copy-webpack-plugin": "^12.0.2",
    "css-minimizer-webpack-plugin": "^7.0.0",
    "eslint": "^6.0.1",
    "eslint-config-airbnb": "^18.0.1",
    "eslint-config-prettier": "^6.7.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^2.3.0",
    "html-webpack-plugin": "^5.6.3",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-canvas-mock": "^2.5.2",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^15.4.3",
    "mini-css-extract-plugin": "^2.9.2",
    "prettier": "^3.4.2",
    "stylelint": "^16.14.0",
    "stylelint-config-lost": "0.0.3",
    "stylelint-config-recommended": "^15.0.0",
    "terser-webpack-plugin": "^5.3.11",
    "webpack": "^5.97.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-middleware": "^7.4.2",
    "webpack-dev-server": "^5.2.0",
    "webpack-hot-middleware": "^2.26.1"
  }
}
